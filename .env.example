# ─── Autotrade Engine Configuration ──────────────────────────────────────────
# Copy to .env and edit before running.

# ── Execution Mode ────────────────────────────────────────────────────────────
# paper        = simulated fills, full PnL tracking, no real orders (default)
# signal_only  = log signals only, no order simulation
# live         = real orders (LIVE_TRADING_ENABLED must also be true)
MODE=paper

# Must explicitly set to "true" to enable live order execution.
LIVE_TRADING_ENABLED=false

# ── Symbol ────────────────────────────────────────────────────────────────────
# NQ1! = E-mini Nasdaq (full-size, $20/pt), MNQ1! = Micro ($2/pt)
SYMBOL=MNQ1!

# ── Trading / Risk Parameters ─────────────────────────────────────────────────
# All trading parameters are in config/indicator-config.json — NOT here.

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_DIR=./logs

# ── Execution Adapter ─────────────────────────────────────────────────────────
EXECUTION_ADAPTER=none

# ── TradingView CDP Connection ────────────────────────────────────────────────
TV_CDP_HOST=127.0.0.1
TV_CDP_PORT=9222

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3900

# ── LOB Bridge (Bookmap/Rithmic sidecar) ──────────────────────────────────────
LOB_SERVICE_URL=http://127.0.0.1:5010
