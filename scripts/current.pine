// NQ Regime & Confluence Dashboard v1.0
// Purpose: At-a-glance regime, alignment, and entry quality assessment for NQ intraday trading
// Designed to replace visual clutter from overlapping indicators with a single dashboard panel
//
// LIMITATIONS:
// - Multi-timeframe data uses request.security with barmerge.lookahead_off to prevent repainting
// - Session times are hardcoded for US Eastern (UTC-5/UTC-4)
// - Regime detection is heuristic, not predictive
// - Dashboard updates on bar close only (no intra-bar flicker)
//
//@version=6
indicator("NQ Regime & Confluence Dashboard", overlay=false, format=format.price)

// ==================== INPUTS ====================
grp_ema = "EMA Settings"
ema_fast_len   = input.int(9, "Fast EMA", group=grp_ema)
ema_mid_len    = input.int(21, "Mid EMA", group=grp_ema)
ema_slow_len   = input.int(50, "Slow EMA", group=grp_ema)
ema_200_len    = input.int(200, "Long EMA", group=grp_ema)

grp_st = "SuperTrend"
st_factor      = input.float(4.0, "Factor", step=0.1, group=grp_st)
st_atr_len     = input.int(10, "ATR Length", group=grp_st)

grp_regime = "Regime Detection"
chop_lookback  = input.int(8, "Chop Detection Bars", group=grp_regime, minval=4, maxval=20)
chop_threshold = input.int(4, "Direction Changes for Chop", group=grp_regime, minval=2, maxval=8)
compress_pct   = input.float(0.25, "Compression % Threshold", step=0.05, group=grp_regime)
vol_spike_mult = input.float(3.0, "Volume Spike Multiplier", step=0.5, group=grp_regime)

grp_session = "Session"
or_minutes     = input.int(15, "Opening Range Minutes", group=grp_session, minval=5, maxval=60)
rth_start_h    = input.int(9, "RTH Start Hour (ET)", group=grp_session)
rth_start_m    = input.int(30, "RTH Start Minute", group=grp_session)

// ==================== CALCULATIONS ====================
// EMAs
ema_fast  = ta.ema(close, ema_fast_len)
ema_mid   = ta.ema(close, ema_mid_len)
ema_slow  = ta.ema(close, ema_slow_len)
ema_200   = ta.ema(close, ema_200_len)

// SuperTrend
[st_line, st_dir] = ta.supertrend(st_factor, st_atr_len)
st_bullish = st_dir < 0

// ATR
atr_val = ta.atr(14)

// RSI
rsi_val = ta.rsi(close, 14)

// Volume
vol_sma = ta.sma(volume, 20)
vol_ratio = vol_sma > 0 ? volume / vol_sma : 1.0

// VWAP (session)
vwap_val = ta.vwap(hlc3)
vwap_dist_pts = close - vwap_val
vwap_dist_pct = vwap_val != 0 ? (vwap_dist_pts / vwap_val) * 100 : 0

// ==================== EMA STACK ANALYSIS ====================
bullish_stack = ema_fast > ema_mid and ema_mid > ema_slow
bearish_stack = ema_fast < ema_mid and ema_mid < ema_slow
stack_quality = bullish_stack or bearish_stack ? "Aligned" : "Mixed"

// Distance between EMAs (spread health)
ema_spread = math.abs(ema_fast - ema_slow)
ema_spread_atr = atr_val > 0 ? ema_spread / atr_val : 0

// ==================== REGIME CLASSIFICATION ====================
// Chop detection: count direction changes in recent bars
var int dir_changes = 0
dir_changes := 0
for i = 1 to chop_lookback - 1
    prev_bull = close[i] > open[i]
    curr_bull = close[i-1] > open[i-1]
    // Skip doji bars
    if math.abs(close[i] - open[i]) > 0.5 and math.abs(close[i-1] - open[i-1]) > 0.5
        if prev_bull != curr_bull
            dir_changes += 1
is_choppy = dir_changes >= chop_threshold

// Compression: range over lookback relative to price
range_10 = ta.highest(high, 10) - ta.lowest(low, 10)
range_pct = close > 0 ? (range_10 / close) * 100 : 0
adaptive_compress = atr_val > 0 ? (atr_val / close * 100 * 0.5) : compress_pct
is_compressed = range_pct < math.max(compress_pct, adaptive_compress)

// Volume impulse
is_vol_spike = vol_ratio > vol_spike_mult

// Trend
is_trending_up = (bullish_stack and st_bullish) or (st_bullish and close > ema_fast)
is_trending_down = (bearish_stack and not st_bullish) or (not st_bullish and close < ema_fast)

// Regime string
regime = is_choppy ? "CHOPPY" : is_vol_spike ? "HV IMPULSE" : is_compressed ? "COMPRESSION" : is_trending_up ? "TREND UP" : is_trending_down ? "TREND DOWN" : "RANGE"

regime_color = switch regime
    "CHOPPY" => color.red
    "HV IMPULSE" => color.orange
    "COMPRESSION" => color.gray
    "TREND UP" => color.green
    "TREND DOWN" => #ff4444
    => color.silver

// ==================== MULTI-TF ALIGNMENT ====================
// 5m
ema9_5m  = request.security(syminfo.tickerid, "5",  ta.ema(close, ema_fast_len), barmerge.gaps_off, barmerge.lookahead_off)
ema200_5m = request.security(syminfo.tickerid, "5", ta.ema(close, ema_200_len), barmerge.gaps_off, barmerge.lookahead_off)
[_, st_dir_5m] = request.security(syminfo.tickerid, "5", ta.supertrend(st_factor, st_atr_len), barmerge.gaps_off, barmerge.lookahead_off)
st_bull_5m = st_dir_5m < 0
close_5m = request.security(syminfo.tickerid, "5", close, barmerge.gaps_off, barmerge.lookahead_off)

// 15m
ema9_15m = request.security(syminfo.tickerid, "15", ta.ema(close, ema_fast_len), barmerge.gaps_off, barmerge.lookahead_off)
ema200_15m = request.security(syminfo.tickerid, "15", ta.ema(close, ema_200_len), barmerge.gaps_off, barmerge.lookahead_off)
[_, st_dir_15m] = request.security(syminfo.tickerid, "15", ta.supertrend(st_factor, st_atr_len), barmerge.gaps_off, barmerge.lookahead_off)
st_bull_15m = st_dir_15m < 0
close_15m = request.security(syminfo.tickerid, "15", close, barmerge.gaps_off, barmerge.lookahead_off)

// 1h
ema200_1h = request.security(syminfo.tickerid, "60", ta.ema(close, ema_200_len), barmerge.gaps_off, barmerge.lookahead_off)
[_, st_dir_1h] = request.security(syminfo.tickerid, "60", ta.supertrend(st_factor, st_atr_len), barmerge.gaps_off, barmerge.lookahead_off)
st_bull_1h = st_dir_1h < 0
close_1h = request.security(syminfo.tickerid, "60", close, barmerge.gaps_off, barmerge.lookahead_off)

// Alignment scoring
tf_1m_bull = close > ema_fast and st_bullish ? 1 : close < ema_fast and not st_bullish ? -1 : 0
tf_5m_bull = close_5m > ema9_5m and st_bull_5m ? 1 : close_5m < ema9_5m and not st_bull_5m ? -1 : 0
tf_15m_bull = close_15m > ema9_15m and st_bull_15m ? 1 : close_15m < ema9_15m and not st_bull_15m ? -1 : 0
tf_1h_bull = close_1h > ema200_1h and st_bull_1h ? 1 : close_1h < ema200_1h and not st_bull_1h ? -1 : 0

bullish_count = (tf_1m_bull > 0 ? 1 : 0) + (tf_5m_bull > 0 ? 1 : 0) + (tf_15m_bull > 0 ? 1 : 0) + (tf_1h_bull > 0 ? 1 : 0)
bearish_count = (tf_1m_bull < 0 ? 1 : 0) + (tf_5m_bull < 0 ? 1 : 0) + (tf_15m_bull < 0 ? 1 : 0) + (tf_1h_bull < 0 ? 1 : 0)
alignment_score = math.max(bullish_count, bearish_count)
alignment_bias = bullish_count > bearish_count ? "LONG" : bearish_count > bullish_count ? "SHORT" : "NEUTRAL"

alignment_color = alignment_score >= 4 ? color.green : alignment_score >= 3 ? color.lime : alignment_score >= 2 ? color.yellow : color.red

// ==================== EXTENSION FROM ANCHORS ====================
ext_from_ema9 = atr_val > 0 ? (close - ema_fast) / atr_val : 0
ext_from_vwap = atr_val > 0 ? vwap_dist_pts / atr_val : 0
is_extended = math.abs(ext_from_ema9) > 2.0 or math.abs(ext_from_vwap) > 2.5

// ==================== COMPOSITE SCORE (0-10) ====================
// Mimics the TypeScript scoring system for visual reference
var float score = 5.0
score := 5.0

// EMA alignment
score += bullish_stack or bearish_stack ? 0.5 : -0.3

// SuperTrend confirmation
st_confirms_bias = (alignment_bias == "LONG" and st_bullish) or (alignment_bias == "SHORT" and not st_bullish)
score += st_confirms_bias ? 0.5 : -0.5

// Multi-TF alignment
score += alignment_score == 4 ? 2.0 : alignment_score == 3 ? 1.0 : alignment_score == 2 ? 0.3 : -0.5

// Regime
score += (is_trending_up or is_trending_down) and not is_choppy ? 0.3 : is_choppy ? -1.0 : 0.0

// Volume
score += vol_ratio > 1.5 ? 0.5 : vol_ratio < 0.5 ? -0.5 : 0.0

// VWAP support
vwap_supports = (alignment_bias == "LONG" and close > vwap_val) or (alignment_bias == "SHORT" and close < vwap_val)
score += vwap_supports ? 0.3 : -0.3

// Extension penalty
score += is_extended ? -0.5 : 0.0

// Clamp
score := math.max(0, math.min(10, score))

score_color = score >= 7.5 ? color.green : score >= 5.0 ? color.yellow : color.red

// ==================== PLOTS ====================
// Main confluence score as histogram
plot(score, "Confluence Score", color=score_color, style=plot.style_columns, linewidth=4)
hline(7.5, "Entry Threshold", color=color.green, linestyle=hline.style_dashed)
hline(5.0, "Neutral", color=color.gray, linestyle=hline.style_dotted)

// Background color for regime
bgcolor(is_choppy ? color.new(color.red, 92) : is_compressed ? color.new(color.gray, 95) : na)

// ==================== DASHBOARD TABLE ====================
var table dash = table.new(position.top_right, columns=2, rows=11, border_width=1, border_color=color.gray, bgcolor=color.new(color.black, 20))

if barstate.islast
    // Header
    table.cell(dash, 0, 0, "NQ Dashboard", bgcolor=color.new(color.blue, 60), text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "v1.0", bgcolor=color.new(color.blue, 60), text_color=color.white, text_size=size.small)

    // Regime
    table.cell(dash, 0, 1, "Regime", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 1, regime, bgcolor=color.new(regime_color, 40), text_color=color.white, text_size=size.tiny)

    // Alignment
    table.cell(dash, 0, 2, "TF Align", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(alignment_score) + "/4 " + alignment_bias, bgcolor=color.new(alignment_color, 40), text_color=color.white, text_size=size.tiny)

    // TF breakdown
    tf1_txt = tf_1m_bull > 0 ? "Bull" : tf_1m_bull < 0 ? "Bear" : "---"
    tf5_txt = tf_5m_bull > 0 ? "Bull" : tf_5m_bull < 0 ? "Bear" : "---"
    tf15_txt = tf_15m_bull > 0 ? "Bull" : tf_15m_bull < 0 ? "Bear" : "---"
    tf60_txt = tf_1h_bull > 0 ? "Bull" : tf_1h_bull < 0 ? "Bear" : "---"
    table.cell(dash, 0, 3, "1m|5m|15m|1h", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 3, tf1_txt + "|" + tf5_txt + "|" + tf15_txt + "|" + tf60_txt, text_color=color.white, text_size=size.tiny)

    // EMA Stack
    stack_txt = bullish_stack ? "BULLISH" : bearish_stack ? "BEARISH" : "MIXED"
    stack_col = bullish_stack ? color.green : bearish_stack ? color.red : color.gray
    table.cell(dash, 0, 4, "EMA Stack", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 4, stack_txt, bgcolor=color.new(stack_col, 50), text_color=color.white, text_size=size.tiny)

    // VWAP
    vwap_txt = "VWAP: " + str.tostring(vwap_dist_pts, "#.#") + " pts"
    vwap_col = close > vwap_val ? color.green : color.red
    table.cell(dash, 0, 5, "VWAP Dist", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 5, vwap_txt, bgcolor=color.new(vwap_col, 60), text_color=color.white, text_size=size.tiny)

    // Extension
    ext_txt = "EMA9: " + str.tostring(ext_from_ema9, "#.#") + "R | VWAP: " + str.tostring(ext_from_vwap, "#.#") + "R"
    ext_col = is_extended ? color.orange : color.green
    table.cell(dash, 0, 6, "Extension", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 6, ext_txt, bgcolor=color.new(ext_col, 60), text_color=color.white, text_size=size.tiny)

    // Volume
    vol_txt = "Vol: " + str.tostring(vol_ratio, "#.#") + "x avg"
    vol_col = vol_ratio > 1.5 ? color.green : vol_ratio < 0.5 ? color.red : color.gray
    table.cell(dash, 0, 7, "Volume", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 7, vol_txt, bgcolor=color.new(vol_col, 60), text_color=color.white, text_size=size.tiny)

    // RSI
    rsi_txt = "RSI: " + str.tostring(rsi_val, "#.#")
    rsi_col = rsi_val > 70 ? color.red : rsi_val < 30 ? color.green : color.gray
    table.cell(dash, 0, 8, "RSI", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 8, rsi_txt, bgcolor=color.new(rsi_col, 60), text_color=color.white, text_size=size.tiny)

    // ATR
    table.cell(dash, 0, 9, "ATR", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 9, str.tostring(atr_val, "#.#") + " pts", text_color=color.white, text_size=size.tiny)

    // Score
    table.cell(dash, 0, 10, "Score", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 10, str.tostring(score, "#.#") + " / 10", bgcolor=color.new(score_color, 30), text_color=color.white, text_size=size.small)
