// NQ Chop vs Trend Quality Meter v1.0
// Purpose: Binary regime filter - should you be trading right now or sitting on hands?
// Specifically tuned for NQ futures intraday on 1m timeframe.
//
// PROBLEM IT SOLVES:
// - The biggest losses in NQ intraday come from trading chop/range conditions
//   when the system generates signals that look valid but whipsaw immediately.
// - This indicator provides a single, clear "trade" or "wait" signal based on
//   multiple regime quality metrics combined.
//
// METHODOLOGY:
// - Combines 5 independent chop/trend measurements into a single 0-100 score:
//   1. ADX (trend strength)
//   2. Choppiness Index (range vs trend)
//   3. EMA slope consistency
//   4. Bar direction consistency
//   5. Volume trend confirmation
//
// LIMITATIONS:
// - Regime changes can be sudden; this indicator reacts, it doesn't predict
// - Short lookback periods (tuned for 1m NQ) may give false signals on other instruments
// - Score thresholds should be calibrated to your specific strategy's historical hit rate
//
//@version=6
indicator("NQ Chop vs Trend Quality", overlay=false)

// ==================== INPUTS ====================
grp_adx = "ADX Settings"
adx_len       = input.int(14, "ADX Length", group=grp_adx, minval=5, maxval=50)
adx_trend_min = input.float(20.0, "ADX Trend Threshold", step=1.0, group=grp_adx)

grp_chop = "Choppiness Index"
chop_len      = input.int(14, "Choppiness Length", group=grp_chop, minval=5, maxval=50)
chop_threshold = input.float(61.8, "Chop Threshold (above = choppy)", step=0.5, group=grp_chop)

grp_slope = "EMA Slope"
slope_ema_len = input.int(21, "Slope EMA Length", group=grp_slope)
slope_lookback = input.int(5, "Slope Lookback Bars", group=grp_slope, minval=2, maxval=20)

grp_bars = "Bar Consistency"
bar_lookback  = input.int(10, "Bar Direction Lookback", group=grp_bars, minval=5, maxval=30)
bar_min_consistency = input.float(60.0, "Min Consistency %", step=5.0, group=grp_bars)

grp_score = "Scoring"
trade_threshold = input.float(60.0, "Trade Quality Threshold", step=5.0, group=grp_score, tooltip="Above this = OK to trade. Below = sit on hands.")

// ==================== CALCULATIONS ====================

// 1. ADX - Trend Strength (0-100)
[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_len)
adx_score = math.min(adx_val / 40.0 * 100, 100)  // Normalize: ADX 40+ = 100

// 2. Choppiness Index (inverted: high chop = low score)
atr_sum = math.sum(ta.atr(1), chop_len)
hi_lo_range = ta.highest(high, chop_len) - ta.lowest(low, chop_len)
chop_index = hi_lo_range > 0 ? 100 * math.log10(atr_sum / hi_lo_range) / math.log10(chop_len) : 50
chop_score = math.max(0, math.min(100, (100 - chop_index) / (100 - chop_threshold) * 100))

// 3. EMA Slope Consistency
ema_slope_val = ta.ema(close, slope_ema_len)
slope = ema_slope_val - ema_slope_val[slope_lookback]
slope_abs = math.abs(slope)
avg_slope = ta.sma(slope_abs, 20)
slope_score = avg_slope > 0 ? math.min(slope_abs / avg_slope * 50, 100) : 50

// Check slope direction consistency
var int slope_consistent_count = 0
slope_consistent_count := 0
for i = 0 to slope_lookback - 1
    s = ema_slope_val[i] - ema_slope_val[i + 1]
    if (slope > 0 and s > 0) or (slope <= 0 and s <= 0)
        slope_consistent_count += 1
slope_consistency_pct = slope_lookback > 0 ? slope_consistent_count / slope_lookback * 100 : 0
slope_score := (slope_score + slope_consistency_pct) / 2

// 4. Bar Direction Consistency
var int same_dir_count = 0
same_dir_count := 0
dominant_dir = close > close[bar_lookback] ? 1 : -1
for i = 0 to bar_lookback - 1
    bar_dir = close[i] > open[i] ? 1 : close[i] < open[i] ? -1 : 0
    if bar_dir == dominant_dir
        same_dir_count += 1
bar_consistency = bar_lookback > 0 ? same_dir_count / bar_lookback * 100 : 50
bar_score = bar_consistency

// 5. Volume Trend Confirmation
vol_sma = ta.sma(volume, 20)
vol_ratio = vol_sma > 0 ? volume / vol_sma : 1.0
// Trending markets should have above-average volume
vol_score = vol_ratio > 1.5 ? 100 : vol_ratio > 1.0 ? 70 : vol_ratio > 0.5 ? 40 : 20

// ==================== COMPOSITE SCORE ====================
// Weighted: ADX 30%, Choppiness 25%, Slope 20%, Bars 15%, Volume 10%
composite = adx_score * 0.30 + chop_score * 0.25 + slope_score * 0.20 + bar_score * 0.15 + vol_score * 0.10

is_tradeable = composite >= trade_threshold

comp_color = composite >= 75 ? color.green : composite >= trade_threshold ? color.lime : composite >= 40 ? color.yellow : composite >= 25 ? color.orange : color.red

// Smoothed version for less noise
composite_smooth = ta.ema(composite, 3)

// ==================== PLOTS ====================
plot(composite_smooth, "Trend Quality", color=comp_color, linewidth=3)
plot(composite, "Raw Quality", color=color.new(comp_color, 60), linewidth=1, style=plot.style_circles)

hline(trade_threshold, "Trade Threshold", color=color.green, linestyle=hline.style_dashed)
hline(40, "Caution Zone", color=color.orange, linestyle=hline.style_dotted)
hline(25, "Sit Out", color=color.red, linestyle=hline.style_dotted)

// Background
bgcolor(composite_smooth < 25 ? color.new(color.red, 92) : composite_smooth < 40 ? color.new(color.orange, 95) : composite_smooth >= 75 ? color.new(color.green, 95) : na)

// ==================== COMPONENT BREAKDOWN TABLE ====================
var table comp_tbl = table.new(position.bottom_left, columns=2, rows=7, border_width=1, border_color=color.gray, bgcolor=color.new(color.black, 20))

if barstate.islast
    status_txt = composite_smooth >= 75 ? "STRONG TREND" : composite_smooth >= trade_threshold ? "TRADEABLE" : composite_smooth >= 40 ? "CAUTION" : composite_smooth >= 25 ? "CHOPPY" : "SIT OUT"
    table.cell(comp_tbl, 0, 0, "Trend Quality", bgcolor=color.new(color.blue, 60), text_color=color.white, text_size=size.small)
    table.cell(comp_tbl, 1, 0, status_txt, bgcolor=color.new(comp_color, 30), text_color=color.white, text_size=size.small)

    table.cell(comp_tbl, 0, 1, "ADX (" + str.tostring(adx_val, "#.#") + ")", text_color=color.white, text_size=size.tiny)
    table.cell(comp_tbl, 1, 1, str.tostring(adx_score, "#") + "/100", text_color=color.white, text_size=size.tiny)

    table.cell(comp_tbl, 0, 2, "Choppiness", text_color=color.white, text_size=size.tiny)
    table.cell(comp_tbl, 1, 2, str.tostring(chop_score, "#") + "/100", text_color=color.white, text_size=size.tiny)

    table.cell(comp_tbl, 0, 3, "EMA Slope", text_color=color.white, text_size=size.tiny)
    table.cell(comp_tbl, 1, 3, str.tostring(slope_score, "#") + "/100", text_color=color.white, text_size=size.tiny)

    table.cell(comp_tbl, 0, 4, "Bar Consistency", text_color=color.white, text_size=size.tiny)
    table.cell(comp_tbl, 1, 4, str.tostring(bar_score, "#") + "/100", text_color=color.white, text_size=size.tiny)

    table.cell(comp_tbl, 0, 5, "Volume", text_color=color.white, text_size=size.tiny)
    table.cell(comp_tbl, 1, 5, str.tostring(vol_score, "#") + "/100", text_color=color.white, text_size=size.tiny)

    table.cell(comp_tbl, 0, 6, "Composite", text_color=color.white, text_size=size.small)
    table.cell(comp_tbl, 1, 6, str.tostring(composite_smooth, "#.#") + " / 100", bgcolor=color.new(comp_color, 30), text_color=color.white, text_size=size.small)

// ==================== ALERTS ====================
alertcondition(ta.crossover(composite_smooth, trade_threshold), "Regime Improving", "Trend quality crossed above trade threshold")
alertcondition(ta.crossunder(composite_smooth, trade_threshold), "Regime Degrading", "Trend quality dropped below trade threshold")
alertcondition(composite_smooth < 25, "Chop Alert", "Regime is choppy - sit on hands")
